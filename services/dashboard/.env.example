# The one thing the browser needs to know: where core_orchestrator lives.
# The rest of the system resolves peers through services.yaml server-side;
# a browser can't read that file directly, so this is the equivalent
# override for the frontend. Copy to .env to change it.
VITE_ORCHESTRATOR_URL=http://localhost:8000

# Google Maps JavaScript API key for the live city map (CityMap.tsx). Get one
# at https://console.cloud.google.com/google/maps-apis/credentials (enable
# "Maps JavaScript API" on the project). Without this set, the map falls
# back to a plain message instead of rendering.
VITE_GOOGLE_MAPS_KEY=
