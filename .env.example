# Copy to .env at the repo root and fill in real values. Loaded via
# python-dotenv's find_dotenv(), which walks up from whichever service's
# cwd it's running in, so one file here covers every Python service.
# (The React dashboard is separate -- see services/dashboard/.env.example.)

# Supabase project backing hospital_ambulance_data (ambulances/hospitals)
# and core_orchestrator (reservations). Service-role key: these are
# trusted backend services with no end-user auth layer of their own, so
# they intentionally bypass RLS -- see
# services/hospital_ambulance_data/migrations/001_schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox Directions API (driving-traffic profile) for real traffic-aware
# ETAs in the routing service. Leave unset to always use the labeled
# Haversine fallback.
MAPBOX_API_KEY=

# --- Live voice call intake (core_orchestrator/app/voice/) ---
# Browser-microphone mode needs none of these. Twilio phone-call mode
# needs all four:
#   1. Create a Deepgram account (developers.deepgram.com) and put its
#      API key here -- streams Twilio's raw call audio to live text.
DEEPGRAM_API_KEY=
#   2. Create a Twilio account + buy/use a phone number
#      (twilio.com/console), put the Account SID / Auth Token / phone
#      number here.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
#   3. Run a public tunnel to this service, e.g.:
#        ngrok http 8000
#      then set this to the https:// (or wss://) origin ngrok prints,
#      e.g. https://abcd1234.ngrok.io -- used to build the TwiML
#      <Stream url> Twilio needs to reach your local machine.
#   4. In the Twilio console, set the phone number's "A call comes in"
#      webhook to: <PUBLIC_TUNNEL_URL>/voice/twilio/incoming-call
PUBLIC_TUNNEL_URL=

# --- In-browser AI conversation mode (core_orchestrator/app/voice/conversation.py) ---
# Powers the mobile "AI Emergency Voice Assistant" (/call): the LLM plays
# the dispatcher, asks follow-up questions, detects Hindi/English/Hinglish
# and replies in kind, and extracts structured patient details live.
# Create a free key at aistudio.google.com/apikey and put it here.
GEMINI_API_KEY=
