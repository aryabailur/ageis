# Copy to .env at the repo root and fill in real values. Loaded via
# python-dotenv's find_dotenv(), which walks up from whichever service's
# cwd it's running in, so one file here covers every Python service.
# (The React dashboard is separate -- see services/dashboard/.env.example.)

# Supabase project backing hospital_ambulance_data (ambulances/hospitals)
# and core_orchestrator (reservations). Service-role key: these are
# trusted backend services with no end-user auth layer of their own, so
# they intentionally bypass RLS -- see
# services/hospital_ambulance_data/migrations/001_schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox Directions API (driving-traffic profile) for real traffic-aware
# ETAs in the routing service. Leave unset to always use the labeled
# Haversine fallback.
MAPBOX_API_KEY=

# Groq (OpenAI-compatible API, llama-3.1-8b-instant) for real LLM-backed
# transcript extraction in core_orchestrator. Leave unset to always use
# the labeled deterministic keyword-extractor fallback.
GROQ_API_KEY=
